# qlib-lab 配置模板。复制为 .env 后修改；.env 已被 gitignore，不要提交。

# ---------------------------------------------------------------- 应用内登录
# 管理员邮箱（逗号分隔）。首次启动会自动创建 admin，并继承现有股票池。
QLIB_ADMIN_EMAIL=you@example.com

# 管理员初始密码。至少 8 位。首次启动会写入数据库；之后修改这里不会覆盖已有密码。
# 重置密码：.venv\Scripts\python web\set_password.py you@example.com
QLIB_ADMIN_PASSWORD=change-me-to-a-long-random-password

# 生产环境走 https，cookie 必须加 Secure；本机 http 调试时改为 0。
QLIB_COOKIE_SECURE=1

# 可选：不填会自动生成 data/private/session_secret（已 gitignore）
# QLIB_SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------- Alpaca Paper（P1）
# 网页端模拟交易改为每个用户在「设置」里填写自己的 Alpaca Paper 密钥。
# 下面三个 .env 变量只用于旧 CLI/本地调试，网页接口不会再用它们兜底。
# APCA_API_KEY_ID=your_paper_key_id
# APCA_API_SECRET_KEY=your_paper_secret_key
# APCA_BASE_URL=https://paper-api.alpaca.markets

# ---------------------------------------------------------------- 密钥加密主密钥
# 可选：不填会自动生成 data/private/master_key（已 gitignore）。
# 一旦保存过用户 Alpaca 密钥，请把 master_key 和数据库一起备份；丢失后需要用户重新填写密钥。
# QLIB_MASTER_KEY=
