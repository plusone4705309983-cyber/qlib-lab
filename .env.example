# Alpaca Paper Trading 配置
# 从 https://alpaca.markets/ 的 Paper Trading -> Developer 获取
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key
APCA_BASE_URL=https://paper-api.alpaca.markets

# ---------------------------------------------------------------- 多用户 P0
# 管理员邮箱（逗号分隔）。首次以该邮箱通过 Cloudflare Access 进入时自动建 admin，
# 并把 config/symbols.yaml 里现有股票复制为他的自选。
QLIB_ADMIN_EMAIL=you@example.com

# 只有请求确实来自 Cloudflare Tunnel 时才信任 Cf-Access-Authenticated-User-Email。
# 应用默认只监听 127.0.0.1；若直接暴露公网，请设为 0。
QLIB_TRUST_CF_HEADER=1

# 本地开发模拟身份：同时设置下面两项后，无需 Cloudflare 也会以该邮箱登录。
# 生产环境务必不要设置；管理员邮箱要同时写进 QLIB_ADMIN_EMAIL。
# QLIB_ALLOW_DEV_LOGIN=1
# QLIB_DEV_EMAIL=you@example.com

# 会话签名密钥；留空时自动生成到 data/private/session_secret（已 gitignore）。
# QLIB_SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------- P1 预留
# Alpaca 密钥加密主密钥（Fernet）。P1 实现 BYOK 时使用。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# QLIB_MASTER_KEY=

# 安全警告：永远不要将真实的 .env 文件提交到 git！
